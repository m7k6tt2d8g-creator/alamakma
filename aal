<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Resonant — Spotify Mood Music Recommender</title>
  <style>
    :root {
      --canvas: #faf9f5; --surface-soft: #f5f0e8; --surface-card: #efe9de;
      --ink: #141413; --body-strong: #252523; --body: #3d3d3a;
      --muted: #6c6a64; --primary: #cc785c; --primary-active: #a9583e;
      --on-primary: #fffdf8; --dark: #181715; --dark-soft: #1f1e1b;
      --on-dark: #faf9f5; --spotify-green: #1ed760;
      --radius-md: 8px; --radius-lg: 12px; --radius-pill: 999px;
      --container: 1160px;
    }
    body { margin: 0; min-height: 100vh; font-family: system-ui, -apple-system, sans-serif; background: var(--canvas); color: var(--body); }
    .serif { font-family: Georgia, serif; font-weight: 500; }
    .container { width: min(var(--container), calc(100% - 40px)); margin: 0 auto; }
    .topbar { position: sticky; top: 0; z-index: 50; height: 68px; background: rgba(250, 249, 245, 0.84); backdrop-filter: blur(18px); border-bottom: 1px solid #e6dfd8; display: flex; align-items: center; }
    .nav { display: flex; justify-content: space-between; width: 100%; align-items: center; }
    .brand { font-weight: 700; color: var(--ink); display: flex; align-items: center; gap: 8px; text-decoration: none; }
    .mark { width: 20px; height: 20px; background: var(--ink); border-radius: 50%; }
    .button { padding: 10px 20px; border-radius: var(--radius-md); border: none; font-weight: 600; cursor: pointer; transition: 0.2s; font-size: 14px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }
    .button-primary { background: var(--primary); color: white; }
    .button-spotify { background: var(--spotify-green); color: black; }
    .recommender-shell { display: grid; grid-template-columns: 1fr 1.2fr; gap: 40px; padding: 60px 0; }
    .form-card { background: var(--surface-card); padding: 32px; border-radius: 24px; border: 1px solid rgba(0,0,0,0.05); }
    .results-card { background: var(--dark); color: var(--on-dark); padding: 32px; border-radius: 24px; position: relative; min-height: 500px; box-shadow: 0 20px 40px rgba(0,0,0,0.2); }
    .field { margin-bottom: 24px; }
    label { display: block; font-size: 13px; font-weight: 700; margin-bottom: 8px; color: var(--ink); }
    textarea, select { width: 100%; padding: 12px; border: 1px solid #d9cfc4; border-radius: 8px; background: white; font-size: 15px; box-sizing: border-box; }
    .chip-row { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip { padding: 8px 16px; border-radius: 99px; border: 1px solid #d9cfc4; background: white; cursor: pointer; font-size: 13px; transition: 0.2s; }
    .chip.active { background: var(--ink); color: white; border-color: var(--ink); }
    .song-card { display: flex; align-items: center; gap: 16px; padding: 12px; background: rgba(255,255,255,0.05); border-radius: 12px; margin-bottom: 12px; text-decoration: none; color: inherit; transition: 0.2s; border: 1px solid rgba(255,255,255,0.05); }
    .song-card:hover { background: rgba(255,255,255,0.12); transform: translateX(5px); border-color: rgba(255,255,255,0.1); }
    .album-art { width: 56px; height: 56px; border-radius: 6px; background-size: cover; flex-shrink: 0; }
    .song-info { flex: 1; min-width: 0; }
    .song-title { font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: white; margin-bottom: 2px; }
    .song-artist { font-size: 13px; color: #a09d96; }
    #login-screen { position: absolute; inset: 0; background: rgba(20,20,19,0.95); display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 24px; z-index: 10; text-align: center; padding: 20px; backdrop-filter: blur(4px); }
    @media (max-width: 850px) { .recommender-shell { grid-template-columns: 1fr; } }
  </style>
</head>
<body>

  <header class="topbar">
    <div class="container nav">
      <a href="/" class="brand"><div class="mark"></div> Resonant</a>
      <div id="user-info" style="font-size: 13px; font-weight: 600; color: var(--primary);"></div>
    </div>
  </header>

  <main class="container">
    <section class="recommender-shell">
      <div class="form-card">
        <h2 class="serif" style="margin-top:0;">오늘의 무드 분석기</h2>
        <div class="field">
          <label>지금 어떤 기분인가요?</label>
          <textarea id="moodText" rows="3" placeholder="예: 밤공기를 마시며 산책할 때 듣기 좋은 차분한 인디 음악"></textarea>
        </div>
        <div class="field">
          <label>선호 장르</label>
          <div class="chip-row" id="genre-seeds">
            <button class="chip active" data-genre="indie">인디</button>
            <button class="chip" data-genre="k-pop">K-Pop</button>
            <button class="chip" data-genre="pop">팝</button>
            <button class="chip" data-genre="jazz">재즈</button>
            <button class="chip" data-genre="r-n-b">R&B</button>
          </div>
        </div>
        <div class="field">
          <label>에너지 수준 (<span id="energy-val">50</span>%)</label>
          <input type="range" id="energy-range" min="0" max="100" value="50" style="width:100%; accent-color:var(--primary);">
        </div>
        <button id="get-recommendations" class="button button-primary" style="width:100%; height:50px; font-size:16px;">AI 선곡 시작</button>
      </div>

      <div class="results-card">
        <div id="login-screen">
            <h3 class="serif" style="color:white; font-size:24px;">Spotify를 연결하세요</h3>
            <p style="color:#a09d96; margin-bottom:24px; max-width:280px;">무드 분석 결과를 실제 음악으로 들으려면 로그인이 필요합니다.</p>
            <button id="login-btn" class="button button-spotify">Spotify 계정으로 로그인</button>
        </div>
        <h3 class="serif" id="result-status" style="margin-top:0;">추천 목록</h3>
        <div id="song-list"></div>
      </div>
    </section>
  </main>

  <script>
    // --- 설정 (본인의 ID로 교체 필요) ---
    const CLIENT_ID = 'YOUR_CLIENT_ID'; 
    const REDIRECT_URI = window.location.href.split('#')[0]; 
    const AUTH_URL = `https://accounts.spotify.com/authorize?client_id=${CLIENT_ID}&response_type=token&redirect_uri=${encodeURIComponent(REDIRECT_URI)}&scope=user-read-private%20user-top-read`;

    let accessToken = null;
    let selectedGenre = 'indie';

    function checkAuth() {
        const hash = window.location.hash;
        if (hash) {
            const params = new URLSearchParams(hash.substring(1));
            accessToken = params.get('access_token');
            if (accessToken) {
                document.getElementById('login-screen').style.display = 'none';
                fetchUserProfile();
            }
        }
    }

    async function fetchUserProfile() {
        try {
            const res = await fetch('https://api.spotify.com/v1/me', {
                headers: { 'Authorization': `Bearer ${accessToken}` }
            });
            const data = await res.json();
            document.getElementById('user-info').textContent = `${data.display_name}님 연결됨`;
        } catch(e) {}
    }

    async function getRecommendations() {
        if (!accessToken) { alert('먼저 로그인을 해주세요!'); return; }
        
        const energy = document.getElementById('energy-range').value / 100;
        const resultStatus = document.getElementById('result-status');
        resultStatus.textContent = "AI가 무드를 분석 중...";

        try {
            const url = `https://api.spotify.com/v1/recommendations?limit=6&seed_genres=${selectedGenre}&target_energy=${energy}&min_popularity=15`;
            const res = await fetch(url, {
                headers: { 'Authorization': `Bearer ${accessToken}` }
            });
            const data = await res.json();
            renderSongs(data.tracks);
            resultStatus.textContent = "오늘의 무드에 맞춘 추천 곡";
        } catch (err) {
            alert('데이터를 가져오지 못했습니다. 다시 로그인해보세요.');
        }
    }

    function renderSongs(tracks) {
        const container = document.getElementById('song-list');
        container.innerHTML = tracks.map(track => `
            <a href="${track.external_urls.spotify}" target="_blank" class="song-card">
                <div class="album-art" style="background-image: url(${track.album.images[0].url})"></div>
                <div class="song-info">
                    <div class="song-title">${track.name}</div>
                    <div class="song-artist">${track.artists.map(a => a.name).join(', ')}</div>
                </div>
                <div style="color:var(--spotify-green); font-size:11px; font-weight:800;">PLAY</div>
            </a>
        `).join('');
    }

    document.getElementById('login-btn').addEventListener('click', () => { window.location.href = AUTH_URL; });
    document.getElementById('get-recommendations').addEventListener('click', getRecommendations);
    document.querySelectorAll('.chip').forEach(chip => {
        chip.addEventListener('click', (e) => {
            document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
            e.target.classList.add('active');
            selectedGenre = e.target.dataset.genre;
        });
    });
    document.getElementById('energy-range').oninput = function() { document.getElementById('energy-val').textContent = this.value; }

    checkAuth();
  </script>
</body>
</html>